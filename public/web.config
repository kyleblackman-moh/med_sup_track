<?xml version="1.0" encoding="UTF-8"?>
<!--
  OVERNIGHT-2 (E1): IIS configuration for the Laravel front controller.
  The site's physical path must be this public folder, never the project root.

  Needs: IIS URL Rewrite 2.1 module, Request Filtering (built in), Static
  Content and Static Content Compression (optional). No other module.

  Uploads: one PDF up to 25 MB (config documents.max_size_kb = 25600). The
  request limit below is 26 MB to allow for the form overhead. PHP must match:
  upload_max_filesize = 25M and post_max_size = 26M in php.ini.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- HTTPS redirect: turn on once the site has a certificate (set enabled="true").
        <rule name="Redirect to HTTPS" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        -->

        <!-- Block dotfiles and dot-folders (.env, .git, .htaccess ...), but allow .well-known. -->
        <rule name="Block dotfiles" stopProcessing="true">
          <match url="(^|/)\.(?!well-known/)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Laravel: send anything that is not a real file or folder to index.php. -->
        <rule name="Laravel front controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>

      <outboundRules>
        <!-- Hide the Server header value (IIS 10 can also remove it: see removeServerHeader below). -->
        <rule name="Blank the Server header">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <security>
      <!-- IIS 10 (Windows Server 2016 and later): drop the Server header entirely. -->
      <requestFiltering removeServerHeader="true">
        <!-- 26 MB in bytes: one 25 MB PDF plus the form overhead. -->
        <requestLimits maxAllowedContentLength="27262976" />

        <!-- Never serve these, even if they end up under public by mistake. -->
        <hiddenSegments applyToWebDAV="true">
          <add segment=".env" />
          <add segment=".git" />
          <add segment="node_modules" />
          <add segment="composer.json" />
          <add segment="composer.lock" />
          <add segment="package.json" />
        </hiddenSegments>

        <fileExtensions allowUnlisted="true" applyToWebDAV="true">
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- PHP adds X-Powered-By unless expose_php = Off; remove it here as well. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Built assets (public/build) are content-hashed, so they can be cached for a long time. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!-- Laravel renders its own error pages; let them through. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- index.php itself is never cached: every page is dynamic. -->
  <location path="index.php">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
